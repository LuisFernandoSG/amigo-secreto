# Puerto de la aplicación (Dokploy inyecta PORT o usa 3000 por defecto)
PORT=3000
HOST=0.0.0.0

# Cadena de conexión a MongoDB
# En Dokploy con Docker Compose: mongodb://mongo:27017/amigo_secreto_navidad
# En Dokploy con servicio MongoDB externo o Atlas: mongodb://usuario:password@host:27017/amigo_secreto_navidad?authSource=admin
MONGODB_URI=mongodb://mongo:27017/amigo_secreto_navidad

# Clave secreta para firmar sesiones JWT
JWT_SECRET=ClaveSuperSecretaParaFirmarJWTsDelSantaDeNavidadGFamiliaCLV

# Si deseas poblar las familias de ejemplo ("GARCIA26" y "PRIMOS26") en una base de datos vacía (true / false)
SEED_DEMO=false
